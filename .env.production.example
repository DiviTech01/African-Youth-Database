# ============================================================
# AYD Platform — Production Environment Variables
# ============================================================

# Database
DATABASE_URL=postgresql://user:password@host:5432/ayd_production

# Auth
JWT_SECRET=generate-a-64-char-random-string-here

# AI (optional — rule-based fallback if not set)
ANTHROPIC_API_KEY=sk-ant-your-key
AI_MODEL=claude-sonnet-4-20250514

# Server
API_PORT=3001
NODE_ENV=production
CORS_ORIGIN=https://africanyouthdatabase.org,https://www.africanyouthdatabase.org

# Frontend
VITE_API_URL=https://api.africanyouthdatabase.org/api

# CMS / Cloudflare R2 (image uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ayd-cms
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Email (Resend) — set these on the API host (Render), not just in a file.
# Newsletter confirmations, admin notices, and approved briefings all need this.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=African Youth Observatory <noreply@pacsda.org>   # domain must be verified in Resend
ADMIN_EMAIL=admin@africanyouthobservatory.org               # receives subscriber + approval emails
FRONTEND_URL=https://africanyouthobservatory.org            # real site — used for admin approval link
PUBLIC_API_URL=https://african-youth-observatory.onrender.com  # base for the unsubscribe link

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============ GEOGRAPHY ============

model Country {
  id              String   @id @default(cuid())
  name            String   @unique
  isoCode2        String   @unique @db.Char(2)
  isoCode3        String   @unique @db.Char(3)
  region          Region
  capital         String
  population      BigInt
  youthPopulation BigInt
  area            Float?
  currency        String?
  languages       String[]
  economicBlocs   String[]
  latitude        Float
  longitude       Float
  flagEmoji       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  indicatorValues  IndicatorValue[]
  youthIndexScores YouthIndexScore[]
  policies         CountryPolicy[]
  experts          Expert[]
  documents        Document[]
  uploadAudits     UploadAudit[]

  @@index([region])
  @@index([isoCode3])
}

enum Region {
  NORTH_AFRICA
  WEST_AFRICA
  CENTRAL_AFRICA
  EAST_AFRICA
  SOUTHERN_AFRICA
}

// ============ THEMES & INDICATORS ============

model Theme {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String
  icon        String
  color       String
  sortOrder   Int
  weight      Float?  // YED Index weight as a fraction (e.g. 0.20 = 20%). Null = not scored.

  indicators Indicator[]
}

model Indicator {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String
  unit        IndicatorUnit
  source      String
  methodology String?
  frequency   String?
  themeId     String

  theme  Theme            @relation(fields: [themeId], references: [id])
  values IndicatorValue[]

  @@index([themeId])
  @@index([slug])
}

enum IndicatorUnit {
  PERCENTAGE
  NUMBER
  INDEX
  RATIO
  RATE
  CURRENCY
  SCORE
  YEARS
}

// ============ DATA VALUES ============

model IndicatorValue {
  id          String     @id @default(cuid())
  value       Float
  year        Int
  gender      GenderType @default(TOTAL)
  ageGroup    String     @default("15-35")
  source      String
  confidence  Float      @default(1.0)
  isEstimate  Boolean    @default(false)
  countryId   String
  indicatorId String
  createdAt   DateTime   @default(now())

  country   Country   @relation(fields: [countryId], references: [id])
  indicator Indicator @relation(fields: [indicatorId], references: [id])

  @@unique([countryId, indicatorId, year, gender, ageGroup])
  @@index([countryId])
  @@index([indicatorId])
  @@index([year])
  @@index([countryId, indicatorId, year])
}

enum GenderType {
  MALE
  FEMALE
  TOTAL
}

// ============ YOUTH INDEX ============

model YouthIndexScore {
  id              String    @id @default(cuid())
  year            Int
  overallScore    Float
  dimensionScores Json      // { "education": 72.5, "employment": 58.2, ... } keyed by theme slug
  rank            Int
  previousRank    Int?
  rankChange      Int?
  percentile      Float
  tier            IndexTier
  countryId       String
  createdAt       DateTime  @default(now())

  country Country @relation(fields: [countryId], references: [id])

  @@unique([countryId, year])
  @@index([year])
  @@index([rank])
}

enum IndexTier {
  HIGH
  MEDIUM_HIGH
  MEDIUM
  MEDIUM_LOW
  LOW
}

// ============ POLICY MONITOR ============

model CountryPolicy {
  id              String  @id @default(cuid())
  countryId       String
  policyName      String
  policyType      String
  yearAdopted     Int?
  yearRevised     Int?
  aycRatified     Boolean @default(false)
  aycRatifiedYear Int?
  wpayCompliant   Boolean @default(false)
  complianceScore Float?
  status          String  @default("active")

  country Country @relation(fields: [countryId], references: [id])

  @@index([countryId])
}

// ============ EXPERTS ============

model Expert {
  id              String       @id @default(cuid())
  name            String
  email           String?      @unique
  title           String
  organization    String?
  countryId       String
  specializations String[]
  languages       String[]
  bio             String?
  verified        Boolean      @default(false)
  status          ExpertStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now()) @updatedAt

  country Country @relation(fields: [countryId], references: [id])

  @@index([countryId])
  @@index([status])
}

enum ExpertStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============ USERS ============

model User {
  id           String    @id  // UUID from Supabase auth.users
  email        String    @unique
  name         String?
  role         UserRole  @default(REGISTERED)
  organization String?
  avatar       String?
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  dashboards        Dashboard[]
  contentDrafts     ContentDraft[]
  contentPublished  ContentPublished[]
  contentRevisions  ContentRevision[]
  documentsUploaded Document[]
  uploadAudits      UploadAudit[]
}

enum UserRole {
  PUBLIC
  REGISTERED
  RESEARCHER
  CONTRIBUTOR
  INSTITUTIONAL
  ADMIN
}

// ============ DASHBOARDS ============

model Dashboard {
  id          String   @id @default(cuid())
  title       String
  description String?
  layout      Json     @default("{}")
  widgets     Json     @default("[]")
  isPublic    Boolean  @default(false)
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// ============ CMS / CONTENT ============

model ContentEntry {
  id             String      @id @default(cuid())
  key            String      @unique
  page           String
  section        String?
  contentType    ContentType @default(TEXT)
  defaultContent String      @default("")
  defaultStyles  Json        @default("{}")
  description    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  draft     ContentDraft?
  published ContentPublished?
  revisions ContentRevision[]

  @@index([page])
  @@index([section])
  @@index([contentType])
}

enum ContentType {
  TEXT
  RICH_TEXT
  IMAGE
}

model ContentDraft {
  id          String   @id @default(cuid())
  entryId     String   @unique
  content     String   @default("")
  styles      Json     @default("{}")
  imageUrl    String?
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  entry     ContentEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  updatedBy User?        @relation(fields: [updatedById], references: [id])

  @@index([updatedById])
}

model ContentPublished {
  id            String   @id @default(cuid())
  entryId       String   @unique
  content       String   @default("")
  styles        Json     @default("{}")
  imageUrl      String?
  version       Int      @default(1)
  publishedById String?
  publishedAt   DateTime @default(now())

  entry       ContentEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  publishedBy User?        @relation(fields: [publishedById], references: [id])

  @@index([publishedById])
}

model ContentRevision {
  id        String         @id @default(cuid())
  entryId   String
  content   String         @default("")
  styles    Json           @default("{}")
  imageUrl  String?
  version   Int
  action    RevisionAction
  actorId   String?
  createdAt DateTime       @default(now())

  entry ContentEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  actor User?        @relation(fields: [actorId], references: [id])

  @@index([entryId, createdAt])
  @@index([actorId])
}

enum RevisionAction {
  SAVE_DRAFT
  PUBLISH
  REVERT
  DISCARD_DRAFT
}

// ============ DATA SOURCES ============

model DataSource {
  id          String    @id @default(cuid())
  name        String    @unique
  url         String?
  description String?
  type        String
  lastSync    DateTime?
  createdAt   DateTime  @default(now())
}

// ============ DOCUMENTS / REPORTS ============
// Contributors upload PDFs and other reference documents. The original blob
// lives in R2 (storageKey); extracted text + a structured summary feed the
// country PKPB page. Numeric data still belongs in IndicatorValue — this
// model is for narrative artifacts.

model Document {
  id               String         @id @default(cuid())
  type             DocumentType
  title            String
  description      String?
  countryId        String?
  country          Country?       @relation(fields: [countryId], references: [id])

  // File metadata
  originalFilename String
  mimeType         String
  fileSize         Int
  storageKey       String         // R2 object key

  // Parsed content
  extractedText    String?        // raw text extracted from the PDF
  extractedSummary Json?          // structured PKPB report fields (see DocumentsService)

  // Bibliographic metadata
  source           String?        // organisation that produced the report
  edition          String?        // e.g. "Dec 2025 · Vol 01"
  year             Int?
  status           DocumentStatus @default(PUBLISHED)

  uploadedById     String?
  uploadedBy       User?          @relation(fields: [uploadedById], references: [id])
  uploadAudits     UploadAudit[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([countryId, type])
  @@index([type])
  @@index([uploadedById])
  @@index([countryId, type, status, createdAt])
}

enum DocumentType {
  PKPB_REPORT
  COUNTRY_REPORT
  POLICY_DOCUMENT
  RESEARCH_PAPER
  OTHER
}

enum DocumentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ============ UPLOAD AUDIT LOG ============
// Every contributor upload (AYIMS template, Policies database, Document, or
// generic CSV) writes one row here on success. This is the source of truth
// for the History tab in the Contributor Hub and survives API restarts —
// the prior in-memory jobStore lost its records every time Render redeployed.
//
// We don't try to be fancy here: one row per commit, with summary stats and
// pointers to the artefacts (Document for PKPB uploads, country for AYIMS,
// nothing for generic-data). Errors land here too with status=FAILED so
// contributors see what went wrong.

model UploadAudit {
  id             String       @id @default(cuid())
  kind           UploadKind
  fileName       String
  fileSize       Int
  status         UploadStatus @default(SUCCESS)
  rowsAffected   Int          @default(0)

  // For uploads that target a single country (AYIMS template, PKPB doc).
  countryId      String?
  country        Country?     @relation(fields: [countryId], references: [id])

  // Bibliographic metadata (carried over from the upload form).
  source         String?
  notes          String?

  // Document link for PKPB / generic document uploads.
  documentId     String?
  document       Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)

  // Who uploaded.
  uploadedById   String?
  uploadedBy     User?        @relation(fields: [uploadedById], references: [id])

  uploadedAt     DateTime     @default(now())
  durationMs     Int?
  errorMessage   String?

  @@index([kind, uploadedAt])
  @@index([countryId])
  @@index([uploadedById])
  @@index([uploadedAt])
}

enum UploadKind {
  AYIMS_TEMPLATE
  POLICIES_DATABASE
  DOCUMENT
  GENERIC_DATA
}

enum UploadStatus {
  SUCCESS
  PARTIAL
  FAILED
}

// Newsletter sign-ups from the public landing/footer forms. Email is unique,
// so a re-subscribe is an upsert (no duplicates). `source` lets us tell where
// the user signed up — useful for downstream analytics on which CTA performs.
model NewsletterSubscription {
  id           String                       @id @default(cuid())
  email        String                       @unique
  source       String?                      // e.g. "landing-hero", "footer", "country-page"
  status       NewsletterSubscriptionStatus @default(SUBSCRIBED)
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt
  unsubscribedAt DateTime?
  metadata     Json?                        // optional extras (locale, country interest, etc.)
  // One-click unsubscribe token embedded in every broadcast email. Nullable so
  // pre-existing rows stay valid; backfilled lazily on next subscribe/send.
  unsubscribeToken String?                  @unique

  @@index([status, createdAt])
}

enum NewsletterSubscriptionStatus {
  SUBSCRIBED
  UNSUBSCRIBED
  BOUNCED
}

// A monthly (or ad-hoc) youth-data briefing. Briefings are NEVER sent
// automatically — the scheduler only drafts one per month and emails an admin
// for review. An admin must explicitly approve a campaign before it is sent to
// the subscriber list. createdById/approvedById hold User ids (no FK, kept
// loose so this stays a self-contained migration).
model NewsletterCampaign {
  id             String                   @id @default(cuid())
  periodKey      String?                  @unique  // "2026-05" for monthly auto-drafts; null for ad-hoc
  title          String                              // internal label, e.g. "May 2026 Youth Briefing"
  subject        String                              // email subject line
  bodyHtml       String                              // inner HTML body (wrapped in branded layout on send)
  status         NewsletterCampaignStatus @default(DRAFT)
  // Who receives this campaign: the public newsletter list, every registered
  // platform user, or both (deduped). Defaults to SUBSCRIBERS to match the
  // original monthly-briefing flow.
  audience       NewsletterAudience       @default(SUBSCRIBERS)
  // Optional download links rendered as an "Attached resources" section at
  // the bottom of the email. Shape: [{ label: string, url: string, sizeHint?: string }].
  // We link rather than attach binaries — better deliverability and works
  // for files of any size (PDFs, reports) hosted on R2 or anywhere public.
  attachments    Json?
  createdById    String?
  approvedById   String?
  recipientCount Int                      @default(0)
  sentCount      Int                      @default(0)
  failedCount    Int                      @default(0)
  testSentTo     String?
  error          String?
  submittedAt    DateTime?
  approvedAt     DateTime?
  sentAt         DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([status, createdAt])
}

enum NewsletterCampaignStatus {
  DRAFT             // editable, not yet submitted
  PENDING_APPROVAL  // submitted, waiting on an admin
  APPROVED          // admin approved; send in progress or queued
  SENDING           // actively sending to subscribers
  SENT              // delivered to the list
  FAILED            // send aborted with an error
  CANCELLED         // admin discarded it
}

enum NewsletterAudience {
  SUBSCRIBERS // people who signed up via the newsletter form
  USERS       // every registered platform user (User table)
  BOTH        // union of the above, deduped by email
}

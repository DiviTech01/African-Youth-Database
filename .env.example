# ============================================================
# AYD Platform — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values

# ---- Database ----
DATABASE_URL="postgresql://ayd_user:ayd_password@localhost:5432/ayd_database?schema=public"

# ---- API Server ----
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development

# ---- Frontend ----
VITE_API_URL=/api

# ---- Mobile app download popup ----
# Public URL of the built Android .apk (e.g. an R2/Cloudflare object or a GitHub
# Release asset). When set, web visitors on a phone see a "Download the app"
# popup linking here. Leave empty to hide the popup (no broken link).
VITE_APK_URL=

# ---- Auth (Supabase) ----
# Supabase owns authentication. The backend ONLY validates JWTs Supabase issues;
# it never creates or signs tokens of its own.
#
# Get this from: Supabase dashboard → Project Settings → API → JWT Secret
# Must match the project the frontend is signing in against (VITE_SUPABASE_URL).
# Without this, every authenticated request returns 401 and JIT user provisioning
# silently fails.
SUPABASE_JWT_SECRET=your-supabase-project-jwt-secret

# Frontend — Supabase client config
VITE_SUPABASE_URL=https://<your-project>.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ---- AI / LLM (optional — rule-based fallback if not set) ----
ANTHROPIC_API_KEY=sk-ant-...
# Per-surface model routing. Omit both to take the current defaults
# (chat: claude-sonnet-5, reports: claude-opus-5).
# The legacy AI_MODEL variable is no longer read.
AI_MODEL_CHAT=claude-sonnet-5
AI_MODEL_REPORT=claude-opus-5

# ---- Resend (Email) ----
# Without RESEND_API_KEY every email is silently skipped (logged, not sent).
RESEND_API_KEY=re_...
# FROM_EMAIL's domain MUST be a verified sending domain in the Resend
# dashboard (pacsda.org here) or Resend rejects the send.
FROM_EMAIL=African Youth Observatory <noreply@pacsda.org>
# Where new-subscriber notices and "briefing needs approval" emails go.
ADMIN_EMAIL=admin@africanyouthdatabase.org
# Used for in-email links AND the admin approval link. In production set this
# to the real site, NOT localhost, or those links break.
FRONTEND_URL=http://localhost:8080
# Absolute API base for the one-click unsubscribe link in every briefing.
# Defaults to the Render URL if unset.
PUBLIC_API_URL=https://african-youth-observatory.onrender.com
# Monitored Reply-To address. Improves Gmail trust signals and lets recipients
# reply to a real human. Falls back to ADMIN_EMAIL when unset.
REPLY_TO_EMAIL=info@africanyouthobservatory.org

# ---- CORS ----
CORS_ORIGIN=http://localhost:8080

# ---- CMS / Cloudflare R2 (image uploads) ----
# Create an R2 bucket + API token at https://dash.cloudflare.com → R2
# Enable public access on the bucket and paste the public URL below.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ayd-cms
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Read-only service token for B.I.L.L.I.E. (the /ops/* status endpoints).
# Any sufficiently random string; the same value must be set in Billie's env.
# Generate: node -e "console.log('ayo_billie_' + require('crypto').randomBytes(24).toString('hex'))"
# Unset => /ops/* returns 503. Non-GET requests are rejected 403 regardless.
AYO_BILLIE_TOKEN=
